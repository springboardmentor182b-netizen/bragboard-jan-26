*.sln
*.sw?
.DS_Store
Thumbs.db

# ─── Accidental frontend files inside server/ ─────────────────────────────────
# These patterns stop JS/JSX/CSS/HTML from being committed into the Python server folder.
server/*.js
server/*.jsx
server/*.ts
server/*.tsx
server/*.css
server/*.html
