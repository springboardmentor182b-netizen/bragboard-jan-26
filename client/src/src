// ─── 3. Password Reset Flow ───────────────────────────────────────────────────

describe('Integration: Password Reset Flow', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('T10: Complete 2-step password reset flow', async () => {
    authAPI.forgotPassword.mockResolvedValueOnce({
      data: { security_question: "What is your first pet's name?" }
    });
    authAPI.resetPassword.mockResolvedValueOnce({ data: { message: 'Password reset' } });

    renderApp('/forgot-password');

    // Step 1
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'user@company.com');
    await userEvent.click(screen.getByRole('button', { name: /continue/i }));

    // Step 2
    await waitFor(() => screen.getByPlaceholderText(/enter your answer/i));
    await userEvent.type(screen.getByPlaceholderText(/enter your answer/i), 'Buddy');
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'newpass456');
    await userEvent.click(screen.getByRole('button', { name: /reset password/i }));

    await waitFor(() => {
      expect(authAPI.resetPassword).toHaveBeenCalledWith({
        email: 'user@company.com',
        security_answer: 'Buddy',
        new_password: 'newpass456',
      });
      expect(screen.getByText(/password reset successfully/i)).toBeInTheDocument();
    });
  });

  it('T11: Wrong security answer shows error', async () => {
    authAPI.forgotPassword.mockResolvedValueOnce({
      data: { security_question: "What is your mother's maiden name?" }
    });
    authAPI.resetPassword.mockRejectedValueOnce({
      response: { data: { detail: 'Incorrect security answer' } }
    });

    renderApp('/forgot-password');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'user@company.com');
    await userEvent.click(screen.getByRole('button', { name: /continue/i }));

    await waitFor(() => screen.getByPlaceholderText(/enter your answer/i));
    await userEvent.type(screen.getByPlaceholderText(/enter your answer/i), 'WrongAnswer');
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'newpass');
    await userEvent.click(screen.getByRole('button', { name: /reset password/i }));

    await waitFor(() => {
      expect(screen.getByText('Incorrect security answer')).toBeInTheDocument();
    });
  });

  it('T12: Non-existent email shows error', async () => {
    authAPI.forgotPassword.mockRejectedValueOnce({
      response: { data: { detail: 'User with this email not found' } }
    });

    renderApp('/forgot-password');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'ghost@company.com');
    await userEvent.click(screen.getByRole('button', { name: /continue/i }));

    await waitFor(() => {
      expect(screen.getByText('User with this email not found')).toBeInTheDocument();
    });
  });

  it('T13: Can navigate back to login from forgot password page', () => {
    renderApp('/forgot-password');
    expect(screen.getByText(/back to login/i)).toBeInTheDocument();
  });
});

// ─── 4. Session Persistence Flow ─────────────────────────────────────────────

describe('Integration: Session Persistence', () => {
  it('T14: Previously logged in user is recognized on app reload', async () => {
    const user = { id: 1, name: 'John Doe', role: 'employee' };
    localStorage.setItem('user', JSON.stringify(user));
    localStorage.setItem('token', 'persistent-token');

    let authContext;
    const Inspector = () => {
      authContext = require('../context/AuthContext').useAuth();
      return null;
    };

    render(
      <MemoryRouter>
        <AuthProvider>
          <Inspector />
        </AuthProvider>
      </MemoryRouter>
    );

    await waitFor(() => {
      expect(localStorage.getItem('token')).toBe('persistent-token');
    });
  });

  it('T15: Logout clears session entirely', async () => {
    const user = { id: 1, name: 'John', role: 'employee' };
    localStorage.setItem('user', JSON.stringify(user));
    localStorage.setItem('token', 'some-token');

    import('../pages/Dashboard').then(({ default: Dashboard }) => {
      renderApp('/dashboard');
    });

    // Simulate logout happened
    localStorage.clear();
    expect(localStorage.getItem('token')).toBeNull();
    expect(localStorage.getItem('user')).toBeNull();
  });
});

// ─── 5. Error Handling & Edge Cases ──────────────────────────────────────────

describe('Integration: Error Handling & Edge Cases', () => {
  beforeEach(() => {
    localStorage.clear();
    vi.clearAllMocks();
  });

  it('T16: Network error during login shows fallback message', async () => {
    authAPI.login.mockRejectedValueOnce(new Error('Network Error'));

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'user@test.com');
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'pass');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));

    await waitFor(() => {
      expect(screen.getByText(/invalid email or password/i)).toBeInTheDocument();
    });
  });

  it('T17: Network error during registration shows fallback message', async () => {
    authAPI.register.mockRejectedValueOnce(new Error('Network Error'));

    renderApp('/register');
    await userEvent.type(await screen.findByPlaceholderText(/john doe/i), 'Test User');
    await userEvent.type(screen.getByPlaceholderText(/email/i), 'test@test.com');
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'password');
    await userEvent.type(screen.getByPlaceholderText(/department/i), 'Engineering');
    await userEvent.selectOptions(screen.getByRole('combobox'), "What is your favorite book?");
    await userEvent.type(screen.getByPlaceholderText(/your answer/i), 'Dune');

    await userEvent.click(screen.getByRole('button', { name: /create account/i }));

    await waitFor(() => {
      expect(screen.getByText(/registration failed/i)).toBeInTheDocument();
    });
  });

  it('T18: Login button stays disabled after multiple failed attempts', async () => {
    authAPI.login.mockRejectedValue({ response: { data: { detail: 'Invalid credentials' } } });

    renderApp('/login');
    const emailInput = await screen.findByPlaceholderText(/email/i);
    const passInput = screen.getByPlaceholderText(/password/i);

    // First attempt
    await userEvent.type(emailInput, 'test@test.com');
    await userEvent.type(passInput, 'wrong1');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));
    await waitFor(() => screen.getByText('Invalid credentials'));

    // Error still visible
    expect(screen.getByText('Invalid credentials')).toBeInTheDocument();
  });

  it('T19: Root path "/" redirects to /login', () => {
    renderApp('/');
    // App should redirect to login
    expect(screen.queryByText(/bragboard/i)).toBeInTheDocument();
  });

  it('T20: Login form is accessible - all inputs have labels', () => {
    renderApp('/login');
    expect(screen.getByText(/email address/i)).toBeInTheDocument();
    expect(screen.getByText(/password/i)).toBeInTheDocument();
  });

  it('T21: Register form is accessible - all inputs have labels', () => {
    renderApp('/register');
    expect(screen.getByText(/full name/i)).toBeInTheDocument();
    expect(screen.getByText(/email address/i)).toBeInTheDocument();
    expect(screen.getByText(/department/i)).toBeInTheDocument();
    expect(screen.getByText(/security question/i)).toBeInTheDocument();
    expect(screen.getByText(/security answer/i)).toBeInTheDocument();
  });

  it('T22: Multiple rapid login clicks only call API once', async () => {
    authAPI.login.mockImplementation(() => new Promise(() => {}));

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'test@test.com');
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'pass');

    const btn = screen.getByRole('button', { name: /sign in/i });
    await userEvent.click(btn);

    // Button becomes disabled - can't click again
    await waitFor(() => expect(btn).toBeDisabled());
    // Only 1 API call
    expect(authAPI.login).toHaveBeenCalledTimes(1);
  });
});

