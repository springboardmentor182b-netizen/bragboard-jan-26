// ─── 7. End-to-End User Journey ───────────────────────────────────────────────

describe('Integration: End-to-End Journey', () => {
  beforeEach(() => {
    localStorage.clear();
    vi.clearAllMocks();
  });

  it('T26: Complete user journey - Register → Login → View Dashboard → Logout', async () => {
    const user = { id: 1, name: 'New User', email: 'new@company.com', role: 'employee' };

    // Step 1: Register
    authAPI.register.mockResolvedValueOnce({ data: { message: 'Created' } });
    renderApp('/register');

    await userEvent.type(await screen.findByPlaceholderText(/john doe/i), user.name);
    await userEvent.type(screen.getByPlaceholderText(/email/i), user.email);
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'userpass123');
    await userEvent.type(screen.getByPlaceholderText(/department/i), 'Design');
    await userEvent.selectOptions(screen.getByRole('combobox'), "What is your first pet's name?");
    await userEvent.type(screen.getByPlaceholderText(/your answer/i), 'Buddy');
    await userEvent.click(screen.getByRole('button', { name: /create account/i }));

    await waitFor(() => {
      expect(screen.getByText(/account created successfully/i)).toBeInTheDocument();
    });

    // Step 2: Login
    authAPI.login.mockResolvedValueOnce({
      data: { access_token: 'fresh-token', user }
    });

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), user.email);
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'userpass123');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));

    await waitFor(() => expect(mockNavigate).toHaveBeenCalledWith('/dashboard'));

    // Step 3: Verify auth state is set
    expect(localStorage.getItem('token')).toBe('fresh-token');
    const storedUser = JSON.parse(localStorage.getItem('user'));
    expect(storedUser.email).toBe(user.email);
  });

  it('T27: Admin journey - Login → View Analytics → View Users → Logout', async () => {
    const admin = { id: 2, name: 'Boss Admin', email: 'boss@company.com', role: 'admin' };
    localStorage.setItem('user', JSON.stringify(admin));
    localStorage.setItem('token', 'boss-token');

    const { default: AdminDashboard } = await import('../pages/AdminDashboard');
    render(
      <MemoryRouter>
        <AuthProvider><AdminDashboard /></AuthProvider>
      </MemoryRouter>
    );

    // Analytics visible by default
    expect(screen.getByText('Total Employees')).toBeInTheDocument();

    // Navigate to Users
    await userEvent.click(screen.getByText('User Management'));
    await waitFor(() => {
      expect(screen.getByText(/manage team members/i)).toBeInTheDocument();
    });

    // Logout
    const logoutBtn = screen.getByTitle('Logout');
    await userEvent.click(logoutBtn);
    expect(mockNavigate).toHaveBeenCalledWith('/login');
    expect(localStorage.getItem('token')).toBeNull();
  });
});
