/**
 * BragBoard - Integration Tests
 * Tests the complete user flows end-to-end (frontend + API layer)
 *
 * Run: npm test
 * These tests simulate real user journeys through the app
 */

import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, waitFor, act } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { MemoryRouter } from 'react-router-dom';
import { AuthProvider } from '../context/AuthContext';
import App from '../App';

// ─── Mocks ────────────────────────────────────────────────────────────────────

vi.mock('../services/api', () => ({
  authAPI: {
    login: vi.fn(),
    register: vi.fn(),
    forgotPassword: vi.fn(),
    resetPassword: vi.fn(),
  },
}));

const mockNavigate = vi.fn();
vi.mock('react-router-dom', async () => {
  const actual = await vi.importActual('react-router-dom');
  return { ...actual, useNavigate: () => mockNavigate };
});

import { authAPI } from '../services/api';

// ─── App Wrapper ──────────────────────────────────────────────────────────────

const renderApp = (initialPath = '/login') =>
  render(
    <MemoryRouter initialEntries={[initialPath]}>
      <AuthProvider>
        <App />
      </AuthProvider>
    </MemoryRouter>
  );

// ─── 1. Complete Employee Registration & Login Flow ───────────────────────────

describe('Integration: Employee Registration → Login Flow', () => {
  beforeEach(() => {
    localStorage.clear();
    vi.clearAllMocks();
  });

  it('T01: User can navigate from login to register page', async () => {
    renderApp('/login');
    const registerLink = await screen.findByText(/create one now/i);
    await userEvent.click(registerLink);
    await waitFor(() => {
      expect(screen.getByText(/create account/i)).toBeInTheDocument();
    });
  });

  it('T02: Complete registration form submission succeeds', async () => {
    authAPI.register.mockResolvedValueOnce({ data: { message: 'Created' } });
    renderApp('/register');

    await userEvent.type(await screen.findByPlaceholderText(/john doe/i), 'Jane Smith');
    await userEvent.type(screen.getByPlaceholderText(/email/i), 'jane@company.com');
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'secure123');
    await userEvent.type(screen.getByPlaceholderText(/department/i), 'Engineering');
    await userEvent.selectOptions(screen.getByRole('combobox'), "What is your first pet's name?");
    await userEvent.type(screen.getByPlaceholderText(/your answer/i), 'Rex');

    await userEvent.click(screen.getByRole('button', { name: /create account/i }));

    await waitFor(() => {
      expect(authAPI.register).toHaveBeenCalledWith({
        name: 'Jane Smith',
        email: 'jane@company.com',
        password: 'secure123',
        department: 'Engineering',
        security_question: "What is your first pet's name?",
        security_answer: 'Rex',
      });
      expect(screen.getByText(/account created successfully/i)).toBeInTheDocument();
    });
  });

  it('T03: Employee login redirects to /dashboard', async () => {
    authAPI.login.mockResolvedValueOnce({
      data: {
        access_token: 'emp-token',
        user: { id: 1, name: 'Jane Smith', email: 'jane@company.com', role: 'employee' }
      }
    });

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'jane@company.com');
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'secure123');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));

    await waitFor(() => expect(mockNavigate).toHaveBeenCalledWith('/dashboard'));
  });

  it('T04: After login, token is stored in localStorage', async () => {
    authAPI.login.mockResolvedValueOnce({
      data: {
        access_token: 'real-jwt-token',
        user: { id: 1, name: 'Jane', email: 'jane@company.com', role: 'employee' }
      }
    });

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'jane@company.com');
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'pass123');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));

    await waitFor(() => {
      expect(localStorage.getItem('token')).toBe('real-jwt-token');
    });
  });

  it('T05: After login, user object is stored in localStorage', async () => {
    const user = { id: 1, name: 'Jane Smith', email: 'jane@company.com', role: 'employee' };
    authAPI.login.mockResolvedValueOnce({
      data: { access_token: 'token', user }
    });

    renderApp('/login');
    await userEvent.type(await screen.findByPlaceholderText(/email/i), 'jane@company.com');
    await userEvent.type(screen.getByPlaceholderText(/password/i), 'pass123');
    await userEvent.click(screen.getByRole('button', { name: /sign in/i }));

    await waitFor(() => {
      const stored = JSON.parse(localStorage.getItem('user'));
      expect(stored).toEqual(user);
    });
  });

  it('T06: Duplicate email shows registration error', async () => {
    authAPI.register.mockRejectedValueOnce({
      response: { data: { detail: 'Email already registered' } }
    });

    renderApp('/register');
    await userEvent.type(await screen.findByPlaceholderText(/john doe/i), 'Jane');
    await userEvent.type(screen.getByPlaceholderText(/email/i), 'existing@company.com');
    await userEvent.type(screen.getByPlaceholderText(/at least 6 characters/i), 'pass');
    await userEvent.type(screen.getByPlaceholderText(/department/i), 'HR');
    await userEvent.selectOptions(screen.getByRole('combobox'), "What city were you born in?");
    await userEvent.type(screen.getByPlaceholderText(/your answer/i), 'NYC');

    await userEvent.click(screen.getByRole('button', { name: /create account/i }));

    await waitFor(() => {
      expect(screen.getByText('Email already registered')).toBeInTheDocument();
    });
  });
});

