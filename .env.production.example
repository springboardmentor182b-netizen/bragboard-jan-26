# ── BragBoard Production Environment ────────────────────────────────────────
# Copy this file to .env.production on the EC2 instance and fill in values.
# NEVER commit .env.production to git.

# ── Database (Neon DB) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:CHANGE_PASSWORD@ep-noisy-water-aok4mba6-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replace with your EC2 public IP and/or domain after deployment
CORS_ORIGINS=http://YOUR_EC2_IP,https://YOUR_DOMAIN

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
