services:
  - type: web
    name: bragboard-api
    runtime: docker
    dockerfilePath: ./server/Dockerfile
    dockerContext: ./server
    plan: free
    envVars:
      - key: DATABASE_URL
        sync: false          # You will paste this from Neon DB
      - key: SECRET_KEY
        generateValue: true  # Render auto-generates a secure value
      - key: ALGORITHM
        value: HS256
      - key: ACCESS_TOKEN_EXPIRE_MINUTES
        value: "30"
      - key: CORS_ORIGINS
        sync: false          # Paste your Netlify URL here after frontend is deployed
      - key: ENVIRONMENT
        value: production
