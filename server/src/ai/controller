from fastapi import APIRouter, HTTPException, Depends
from pydantic import BaseModel
from typing import List
import os, httpx

from src.auth.dependencies import get_current_user
from src.entities.user import User

router = APIRouter(prefix="/ai", tags=["AI"])

ANTHROPIC_API_KEY = os.getenv("ANTHROPIC_API_KEY", "")
ANTHROPIC_URL = "https://api.anthropic.com/v1/messages"


class AutoTagRequest(BaseModel):
    message: str


class AutoTagResponse(BaseModel):
    tags: List[str]


@router.post("/auto-tag", response_model=AutoTagResponse)
async def auto_tag(
    body: AutoTagRequest,
    current_user: User = Depends(get_current_user),
):
    """
    Given a shoutout message, return a list of relevant skill tags.
    Each tag is returned as a plain string (no # prefix).
    """
    if not ANTHROPIC_API_KEY:
        raise HTTPException(
            status_code=503,
            detail="AI tagging is not configured. Set ANTHROPIC_API_KEY in your .env file.",
        )

    if not body.message or len(body.message.strip()) < 5:
        raise HTTPException(status_code=400, detail="Message is too short to tag.")

    prompt = (
        "You are a skill-tagging assistant for a professional recognition platform called Bragboard.\n\n"
        "Given the shoutout message below, extract 3–6 relevant skill tags. "
        "Classify each as either a soft skill (e.g. Leadership, Teamwork, Communication) "
        "or a hard skill (e.g. Python, SQL, React, Data Analysis).\n\n"
        "Return ONLY a valid JSON array of plain tag name strings. "
        "No # prefix, no explanation, no markdown, no extra text.\n"
        "Example: [\"Leadership\", \"Python\", \"Project Management\", \"Teamwork\"]\n\n"
        f"Shoutout: \"{body.message.strip()}\""
    )

    async with httpx.AsyncClient(timeout=15) as client:
        response = await client.post(
            ANTHROPIC_URL,
            headers={
                "x-api-key": ANTHROPIC_API_KEY,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json={
                "model": "claude-haiku-4-5-20251001",
                "max_tokens": 200,
                "messages": [{"role": "user", "content": prompt}],
            },
        )

    if response.status_code != 200:
        raise HTTPException(
            status_code=502,
            detail=f"AI service error: {response.text}",
        )

    data = response.json()
    raw = data["content"][0]["text"].strip()
    # Strip any accidental markdown fences
    clean = raw.replace("```json", "").replace("```", "").strip()

    try:
        import json
        tags: List[str] = json.loads(clean)
        if not isinstance(tags, list):
            raise ValueError("Expected a list")
        tags = [str(t).strip().lstrip("#") for t in tags if t]
    except Exception:
        raise HTTPException(status_code=502, detail="AI returned an unexpected format.")

    return AutoTagResponse(tags=tags)
